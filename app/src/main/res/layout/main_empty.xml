<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center_vertical"
    android:layout_marginStart="@dimen/list_margin_horizontal"
    android:layout_marginLeft="@dimen/list_margin_horizontal"
    android:layout_marginEnd="@dimen/list_margin_horizontal"
    android:layout_marginRight="@dimen/list_margin_horizontal"
    android:background="?attr/listBackgroundColor"
    android:elevation="2dp"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout style="@style/EmptyStateRow">

        <ImageView
            style="@style/EmptyStateIcon"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            app:tint="?attr/resultColor" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/EmptyStateTitle"
                android:text="@string/ui_empty_search" />

            <TextView
                style="@style/EmptyStateSubtitle"
                android:text="@string/ui_empty_search_sub" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout style="@style/EmptyStateRow">

        <ImageView
            style="@style/EmptyStateIcon"
            android:contentDescription="@null"
            android:src="@drawable/ic_wifi_off"
            app:tint="?attr/resultColor" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/EmptyStateTitle"
                android:text="@string/ui_empty_privacy" />

            <TextView
                style="@style/EmptyStateSubtitle"
                android:text="@string/ui_empty_privacy_sub" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout style="@style/EmptyStateRow">

        <ImageView
            style="@style/EmptyStateIcon"
            android:contentDescription="@null"
            android:src="@drawable/ic_history"
            app:tint="?attr/resultColor" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/EmptyStateTitle"
                android:text="@string/ui_empty_learn" />

            <TextView
                style="@style/EmptyStateSubtitle"
                android:text="@string/ui_empty_learn_sub" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
